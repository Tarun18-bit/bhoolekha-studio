# Gemini Vision (used for photos/scans; Bhulekh PDFs are read from their text layer without it)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional backup keys (tried in order if the first fails)
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Password for the three demo accounts (operator / verifier / admin). Default: demo@123
# Applied when the accounts are created, i.e. after `python reset_demo_data.py --yes`.
# DEMO_PASSWORD=

# Secret used to sign login tokens. If unset, one is generated into server/.auth_secret.
# AUTH_SECRET=
